{
  "engine": {
    "type": "redis",
    "redis": {
      "address": "redis://redis:6379"
    }
  },
  "health": {
    "enabled": true
  },
  "client": {
    "allowed_origins": []
  },
  "channel": {
    "namespaces": [
      {
        "name": "invoices",
        "allow_history_for_client": true,
        "history_size": 20,
        "history_ttl": "120s"
      },
      {
        "name": "notifications",
        "presence": true,
        "allow_presence_for_client": true,
        "allow_history_for_client": true,
        "force_recovery": true,
        "history_size": 50,
        "history_ttl": "3600s"
      },
      {
        "name": "dashboard",
        "presence": true,
        "allow_presence_for_client": true
      },
      {
        "name": "user",
        "allow_history_for_client": true,
        "history_size": 10,
        "history_ttl": "60s"
      },
      {
        "name": "import",
        "allow_history_for_client": true,
        "history_size": 10,
        "history_ttl": "300s"
      },
      {
        "name": "backup",
        "allow_history_for_client": true,
        "history_size": 10,
        "history_ttl": "300s"
      }
    ]
  }
}
