{% extends 'emails/notification_base.html.twig' %}

{% block accent_gradient %}background: linear-gradient(90deg, #3b82f6 0%, #60a5fa 50%, #93c5fd 100%);{% endblock %}

{% block icon_emoji %}
    <div style="display: inline-block; width: 64px; height: 64px; border-radius: 50%; background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); text-align: center; line-height: 64px; font-size: 30px; box-shadow: 0 4px 12px rgba(59,130,246,0.15);">
        &#128229;
    </div>
{% endblock %}

{% block heading %}{{ 'notifications.spv_new_documents.heading'|trans({}, 'emails', locale) }}{% endblock %}

{% block content %}
    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background-color: #eff6ff; border: 1px solid #bfdbfe; border-radius: 10px; margin-bottom: 20px;">
        <tr>
            <td style="padding: 18px 20px;">
                <p style="margin: 0; font-size: 14px; color: #1e40af; line-height: 1.5;">{{ message }}</p>
            </td>
        </tr>
    </table>

    {% if data.count is defined %}
    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="border: 1px solid #e5e7eb; border-radius: 10px; overflow: hidden;">
        <tr style="background-color: #f9fafb;">
            <td style="padding: 13px 20px; font-size: 14px; color: #6b7280;">{{ 'notifications.new_documents'|trans({}, 'emails', locale) }}</td>
            <td style="padding: 13px 20px; font-size: 14px; color: #111827; font-weight: 600; text-align: right;">{{ data.count }}</td>
        </tr>
    </table>
    {% endif %}
{% endblock %}
