{% extends 'emails/notification_base.html.twig' %}

{% set days = data.daysLeft|default(0) %}
{% set urgent = days <= 1 %}
{% set code = data.code|default('') %}

{% block accent_gradient %}background: linear-gradient(90deg, {{ urgent ? '#ef4444 0%, #f87171 50%, #fca5a5' : '#6366f1 0%, #818cf8 50%, #a5b4fc' }} 100%);{% endblock %}

{% block icon_emoji %}
    <div style="display: inline-block; width: 64px; height: 64px; border-radius: 50%; background: linear-gradient(135deg, {{ urgent ? '#fef2f2 0%, #fee2e2' : '#eef2ff 0%, #e0e7ff' }} 100%); text-align: center; line-height: 64px; font-size: 30px; box-shadow: 0 4px 12px rgba({{ urgent ? '239,68,68' : '99,102,241' }},0.15);">
        &#128197;
    </div>
{% endblock %}

{% block heading %}{{ code ? (days == 0 ? 'notifications.fiscal_deadline.heading_named_today' : 'notifications.fiscal_deadline.heading_named')|trans({'%code%': code, '%count%': days}, 'emails', locale)
    : (days == 0 ? 'notifications.fiscal_deadline.heading_today' : 'notifications.fiscal_deadline.heading')|trans({}, 'emails', locale) }}{% endblock %}

{% block content %}
    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background-color: {{ urgent ? '#fef2f2' : '#eef2ff' }}; border: 1px solid {{ urgent ? '#fecaca' : '#c7d2fe' }}; border-radius: 10px; margin-bottom: 20px;">
        <tr>
            <td style="padding: 18px 20px;">
                <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
                    <tr>
                        <td style="width: 24px; vertical-align: top; padding-top: 1px;">
                            <div style="width: 20px; height: 20px; border-radius: 50%; background: {{ urgent ? '#ef4444' : '#6366f1' }}; text-align: center; line-height: 20px; font-size: 12px; color: #fff;">!</div>
                        </td>
                        <td style="padding-left: 12px;">
                            {% if data.label is defined and data.label %}
                            <p style="margin: 0 0 4px 0; font-size: 14px; font-weight: 700; color: {{ urgent ? '#991b1b' : '#3730a3' }};">{{ data.label }}</p>
                            {% endif %}
                            <p style="margin: 0; font-size: 14px; color: {{ urgent ? '#7f1d1d' : '#312e81' }}; line-height: 1.5;">{{ message }}</p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="border: 1px solid #e5e7eb; border-radius: 10px; overflow: hidden;">
        <tr style="background-color: #f9fafb;">
            <td style="padding: 13px 20px; font-size: 14px; color: #6b7280;">{{ 'notifications.fiscal_deadline.declaration'|trans({}, 'emails', locale) }}</td>
            <td style="padding: 13px 20px; font-size: 14px; color: #111827; font-weight: 600; text-align: right;">{{ code ?: '—' }}{% if data.label is defined and data.label %} · {{ data.label }}{% endif %}</td>
        </tr>
        {% if data.periodLabel is defined and data.periodLabel %}
        <tr>
            <td style="padding: 13px 20px; font-size: 14px; color: #6b7280; border-top: 1px solid #e5e7eb;">{{ 'notifications.fiscal_deadline.period'|trans({}, 'emails', locale) }}</td>
            <td style="padding: 13px 20px; font-size: 14px; color: #111827; font-weight: 600; text-align: right; border-top: 1px solid #e5e7eb;">{{ data.periodLabel }}</td>
        </tr>
        {% endif %}
        <tr style="background-color: #f9fafb;">
            <td style="padding: 13px 20px; font-size: 14px; color: #6b7280; border-top: 1px solid #e5e7eb;">{{ 'notifications.fiscal_deadline.due_date'|trans({}, 'emails', locale) }}</td>
            <td style="padding: 13px 20px; font-size: 14px; color: {{ urgent ? '#b91c1c' : '#111827' }}; font-weight: 700; text-align: right; border-top: 1px solid #e5e7eb;">{{ data.dueDateLabel|default(data.dueDate|default('—')) }}</td>
        </tr>
        {% if data.companyName is defined and data.companyName %}
        <tr>
            <td style="padding: 13px 20px; font-size: 14px; color: #6b7280; border-top: 1px solid #e5e7eb;">{{ 'notifications.company'|trans({}, 'emails', locale) }}</td>
            <td style="padding: 13px 20px; font-size: 14px; color: #111827; font-weight: 600; text-align: right; border-top: 1px solid #e5e7eb;">{{ data.companyName }}</td>
        </tr>
        {% endif %}
    </table>

    <p style="margin: 18px 0 0 0; font-size: 13px; color: #6b7280; line-height: 1.6;">{{ 'notifications.fiscal_deadline.hint'|trans({}, 'emails', locale) }}</p>
{% endblock %}

{% block cta %}
    {% if data.companyId is defined %}
    <tr>
        <td style="padding: 0 36px 32px 36px;" align="center">
            {% set target = data.declarationType is defined and data.declarationType
                ? '/declarations?create=' ~ data.declarationType ~ '&year=' ~ (data.period.year|default(''))
                : '/fiscal-calendar' %}
            {% set link = frontendUrl ~ target ~ ('?' in target ? '&' : '?') ~ 'company=' ~ data.companyId %}
            <a href="{{ link }}" target="_blank"
               style="display: inline-block; background: linear-gradient(135deg, {{ urgent ? '#dc2626 0%, #ef4444' : '#4f46e5 0%, #6366f1' }} 100%); color: #ffffff; font-size: 15px; font-weight: 600; text-decoration: none; padding: 14px 40px; border-radius: 8px; box-shadow: 0 2px 8px rgba({{ urgent ? '220,38,38' : '79,70,229' }},0.3);">
                {{ (data.declarationType is defined and data.declarationType ? 'notifications.fiscal_deadline.cta_create' : 'notifications.fiscal_deadline.cta_calendar')|trans({}, 'emails', locale) }}
            </a>
        </td>
    </tr>
    {% endif %}
{% endblock %}
