{% extends 'emails/notification_base.html.twig' %}

{% set days = data.days|default(0) %}
{% set urgent = days <= 1 %}

{% block accent_gradient %}background: linear-gradient(90deg, {{ urgent ? '#ef4444 0%, #f87171 50%, #fca5a5' : '#0ea5e9 0%, #38bdf8 50%, #7dd3fc' }} 100%);{% endblock %}

{% block icon_emoji %}
    <div style="display: inline-block; width: 64px; height: 64px; border-radius: 50%; background: linear-gradient(135deg, {{ urgent ? '#fef2f2 0%, #fee2e2' : '#f0f9ff 0%, #e0f2fe' }} 100%); text-align: center; line-height: 64px; font-size: 30px; box-shadow: 0 4px 12px rgba({{ urgent ? '239,68,68' : '14,165,233' }},0.15);">
        &#128193;
    </div>
{% endblock %}

{% block heading %}{{ (days == 0 ? 'notifications.dosar_deadline.heading_today' : 'notifications.dosar_deadline.heading')|trans({'%count%': days}, 'emails', locale) }}{% endblock %}

{% block content %}
    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background-color: {{ urgent ? '#fef2f2' : '#f0f9ff' }}; border: 1px solid {{ urgent ? '#fecaca' : '#bae6fd' }}; border-radius: 10px; margin-bottom: 20px;">
        <tr>
            <td style="padding: 18px 20px;">
                <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
                    <tr>
                        <td style="width: 24px; vertical-align: top; padding-top: 1px;">
                            <div style="width: 20px; height: 20px; border-radius: 50%; background: {{ urgent ? '#ef4444' : '#0ea5e9' }}; text-align: center; line-height: 20px; font-size: 12px; color: #fff;">!</div>
                        </td>
                        <td style="padding-left: 12px;">
                            {% if data.dosarTitle is defined and data.dosarTitle %}
                            <p style="margin: 0 0 4px 0; font-size: 14px; font-weight: 700; color: {{ urgent ? '#991b1b' : '#075985' }};">{{ data.dosarTitle }}</p>
                            {% endif %}
                            <p style="margin: 0; font-size: 14px; color: {{ urgent ? '#7f1d1d' : '#0c4a6e' }}; line-height: 1.5;">{{ message }}</p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="border: 1px solid #e5e7eb; border-radius: 10px; overflow: hidden;">
        {% if data.dosarTitle is defined and data.dosarTitle %}
        <tr style="background-color: #f9fafb;">
            <td style="padding: 13px 20px; font-size: 14px; color: #6b7280;">{{ 'notifications.dosar_deadline.dosar'|trans({}, 'emails', locale) }}</td>
            <td style="padding: 13px 20px; font-size: 14px; color: #111827; font-weight: 600; text-align: right;">{{ data.dosarTitle }}</td>
        </tr>
        {% endif %}
        {% if data.label is defined and data.label %}
        <tr>
            <td style="padding: 13px 20px; font-size: 14px; color: #6b7280; border-top: 1px solid #e5e7eb;">{{ 'notifications.dosar_deadline.step'|trans({}, 'emails', locale) }}</td>
            <td style="padding: 13px 20px; font-size: 14px; color: #111827; font-weight: 600; text-align: right; border-top: 1px solid #e5e7eb;">{{ data.label }}</td>
        </tr>
        {% endif %}
        <tr style="background-color: #f9fafb;">
            <td style="padding: 13px 20px; font-size: 14px; color: #6b7280; border-top: 1px solid #e5e7eb;">{{ 'notifications.dosar_deadline.due_date'|trans({}, 'emails', locale) }}</td>
            <td style="padding: 13px 20px; font-size: 14px; color: {{ urgent ? '#b91c1c' : '#111827' }}; font-weight: 700; text-align: right; border-top: 1px solid #e5e7eb;">{{ data.deadlineAtLabel|default('—') }}</td>
        </tr>
        {% if data.companyName is defined and data.companyName %}
        <tr>
            <td style="padding: 13px 20px; font-size: 14px; color: #6b7280; border-top: 1px solid #e5e7eb;">{{ 'notifications.company'|trans({}, 'emails', locale) }}</td>
            <td style="padding: 13px 20px; font-size: 14px; color: #111827; font-weight: 600; text-align: right; border-top: 1px solid #e5e7eb;">{{ data.companyName }}</td>
        </tr>
        {% endif %}
    </table>

    <p style="margin: 18px 0 0 0; font-size: 13px; color: #6b7280; line-height: 1.6;">{{ 'notifications.dosar_deadline.hint'|trans({}, 'emails', locale) }}</p>
{% endblock %}

{% block cta %}
    {% if data.companyId is defined %}
    <tr>
        <td style="padding: 0 36px 32px 36px;" align="center">
            <a href="{{ frontendUrl }}{{ data.url|default('/dosare') }}?company={{ data.companyId }}" target="_blank"
               style="display: inline-block; background: linear-gradient(135deg, {{ urgent ? '#dc2626 0%, #ef4444' : '#0284c7 0%, #0ea5e9' }} 100%); color: #ffffff; font-size: 15px; font-weight: 600; text-decoration: none; padding: 14px 40px; border-radius: 8px; box-shadow: 0 2px 8px rgba({{ urgent ? '220,38,38' : '2,132,199' }},0.3);">
                {{ 'notifications.dosar_deadline.cta'|trans({}, 'emails', locale) }}
            </a>
        </td>
    </tr>
    {% endif %}
{% endblock %}
