{% extends 'emails/notification_base.html.twig' %}

{% block accent_gradient %}background: linear-gradient(90deg, #dc2626 0%, #f87171 50%, #fca5a5 100%);{% endblock %}

{% block icon_emoji %}
    <div style="display: inline-block; width: 64px; height: 64px; border-radius: 50%; background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%); text-align: center; line-height: 64px; font-size: 30px; box-shadow: 0 4px 12px rgba(239,68,68,0.15);">
        &#9888;&#65039;
    </div>
{% endblock %}

{% block heading %}{{ 'notifications.spv_unpaid_balance.heading'|trans({}, 'emails', locale) }}{% endblock %}

{% block content %}
    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background-color: #fef2f2; border: 1px solid #fecaca; border-radius: 10px; margin-bottom: 20px;">
        <tr>
            <td style="padding: 18px 20px;">
                <p style="margin: 0 0 4px 0; font-size: 14px; font-weight: 700; color: #991b1b;">{{ data.companyName|default('') }}</p>
                <p style="margin: 0; font-size: 14px; color: #7f1d1d; line-height: 1.5;">{{ message }}</p>
            </td>
        </tr>
    </table>

    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="border: 1px solid #e5e7eb; border-radius: 10px; overflow: hidden;">
        <tr style="background-color: #f9fafb;">
            <td style="padding: 13px 20px; font-size: 14px; color: #6b7280;">{{ 'notifications.spv_unpaid_balance.as_of'|trans({}, 'emails', locale) }}</td>
            <td style="padding: 13px 20px; font-size: 14px; color: #111827; font-weight: 600; text-align: right;">{{ data.asOfLabel|default('—') }}</td>
        </tr>
        <tr>
            <td style="padding: 13px 20px; font-size: 14px; color: #6b7280; border-top: 1px solid #e5e7eb;">{{ 'notifications.spv_unpaid_balance.unpaid'|trans({}, 'emails', locale) }}</td>
            <td style="padding: 13px 20px; font-size: 14px; color: #b91c1c; font-weight: 700; text-align: right; border-top: 1px solid #e5e7eb;">{{ data.unpaid|default(0)|number_format(0, ',', '.') }} RON</td>
        </tr>
        <tr style="background-color: #f9fafb;">
            <td style="padding: 13px 20px; font-size: 14px; color: #6b7280; border-top: 1px solid #e5e7eb;">{{ 'notifications.spv_unpaid_balance.accessories'|trans({}, 'emails', locale) }}</td>
            <td style="padding: 13px 20px; font-size: 14px; color: #111827; font-weight: 600; text-align: right; border-top: 1px solid #e5e7eb;">{{ ((data.interest|default(0)) + (data.penalties|default(0)))|number_format(0, ',', '.') }} RON</td>
        </tr>
        {% for row in data.unpaidByTax|default([])|filter(row => row.unpaid > 0) %}
        <tr>
            <td style="padding: 11px 20px 11px 32px; font-size: 13px; color: #6b7280; border-top: 1px solid #e5e7eb;">{{ loop.first ? ('notifications.spv_unpaid_balance.by_tax'|trans({}, 'emails', locale) ~ ' — ') : '' }}{{ row.tax }}</td>
            <td style="padding: 11px 20px; font-size: 13px; color: #111827; font-weight: 600; text-align: right; border-top: 1px solid #e5e7eb;">{{ row.unpaid|number_format(0, ',', '.') }} RON</td>
        </tr>
        {% endfor %}
    </table>

    <p style="margin: 18px 0 0 0; font-size: 13px; color: #6b7280; line-height: 1.6;">{{ 'notifications.spv_unpaid_balance.hint'|trans({}, 'emails', locale) }}</p>
{% endblock %}

{% block cta %}
    {% if data.companyId is defined %}
    <tr>
        <td style="padding: 0 36px 32px 36px;" align="center">
            <a href="{{ frontendUrl }}/spv{% if data.documentId is defined %}?document={{ data.documentId }}{% endif %}&company={{ data.companyId }}" target="_blank"
               style="display: inline-block; background: linear-gradient(135deg, #dc2626 0%, #ef4444 100%); color: #ffffff; font-size: 15px; font-weight: 600; text-decoration: none; padding: 14px 40px; border-radius: 8px; box-shadow: 0 2px 8px rgba(220,38,38,0.3);">
                {{ 'notifications.spv_unpaid_balance.cta'|trans({}, 'emails', locale) }}
            </a>
        </td>
    </tr>
    {% endif %}
{% endblock %}
