{% extends 'emails/notification_base.html.twig' %}

{% set isClient = (data.partnerType|default('client')) == 'client' %}

{% block accent_gradient %}background: linear-gradient(90deg, #f59e0b 0%, #fbbf24 50%, #fcd34d 100%);{% endblock %}

{% block icon_emoji %}
    <div style="display: inline-block; width: 64px; height: 64px; border-radius: 50%; background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%); text-align: center; line-height: 64px; font-size: 30px; box-shadow: 0 4px 12px rgba(245,158,11,0.15);">
        &#127970;
    </div>
{% endblock %}

{% block heading %}{{ 'notifications.partner_status_changed.heading'|trans({}, 'emails', locale) }}{% endblock %}

{% block content %}
    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background-color: #fffbeb; border: 1px solid #fde68a; border-radius: 10px; margin-bottom: 20px;">
        <tr>
            <td style="padding: 18px 20px;">
                <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
                    <tr>
                        <td style="width: 24px; vertical-align: top; padding-top: 1px;">
                            <div style="width: 20px; height: 20px; border-radius: 50%; background: #f59e0b; text-align: center; line-height: 20px; font-size: 12px; color: #fff;">!</div>
                        </td>
                        <td style="padding-left: 12px;">
                            {% if data.partnerName is defined and data.partnerName %}
                            <p style="margin: 0 0 4px 0; font-size: 14px; font-weight: 700; color: #92400e;">{{ data.partnerName }}</p>
                            {% endif %}
                            <p style="margin: 0; font-size: 14px; color: #78350f; line-height: 1.5;">{{ message }}</p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="border: 1px solid #e5e7eb; border-radius: 10px; overflow: hidden;">
        <tr style="background-color: #f9fafb;">
            <td style="padding: 13px 20px; font-size: 14px; color: #6b7280;">{{ (isClient ? 'notifications.partner_status_changed.client' : 'notifications.partner_status_changed.supplier')|trans({}, 'emails', locale) }}</td>
            <td style="padding: 13px 20px; font-size: 14px; color: #111827; font-weight: 600; text-align: right;">{{ data.partnerName|default('—') }}</td>
        </tr>
        {% if data.identifier is defined and data.identifier %}
        <tr>
            <td style="padding: 13px 20px; font-size: 14px; color: #6b7280; border-top: 1px solid #e5e7eb;">{{ 'notifications.partner_status_changed.identifier'|trans({}, 'emails', locale) }}</td>
            <td style="padding: 13px 20px; font-size: 14px; color: #111827; font-weight: 600; text-align: right; border-top: 1px solid #e5e7eb;">{{ data.identifier }}</td>
        </tr>
        {% endif %}
        {% if data.changeLabels is defined and data.changeLabels %}
        <tr style="background-color: #f9fafb;">
            <td style="padding: 13px 20px; font-size: 14px; color: #6b7280; border-top: 1px solid #e5e7eb; vertical-align: top;">{{ 'notifications.partner_status_changed.changes'|trans({}, 'emails', locale) }}</td>
            <td style="padding: 13px 20px; font-size: 14px; color: #111827; font-weight: 600; text-align: right; border-top: 1px solid #e5e7eb;">
                {% for change in data.changeLabels %}{{ change }}{% if not loop.last %}<br>{% endif %}{% endfor %}
            </td>
        </tr>
        {% endif %}
        {% if data.checkedAtLabel is defined and data.checkedAtLabel %}
        <tr>
            <td style="padding: 13px 20px; font-size: 14px; color: #6b7280; border-top: 1px solid #e5e7eb;">{{ 'notifications.partner_status_changed.checked_at'|trans({}, 'emails', locale) }}</td>
            <td style="padding: 13px 20px; font-size: 14px; color: #111827; font-weight: 600; text-align: right; border-top: 1px solid #e5e7eb;">{{ data.checkedAtLabel }}</td>
        </tr>
        {% endif %}
        {% if data.companyName is defined and data.companyName %}
        <tr style="background-color: #f9fafb;">
            <td style="padding: 13px 20px; font-size: 14px; color: #6b7280; border-top: 1px solid #e5e7eb;">{{ 'notifications.company'|trans({}, 'emails', locale) }}</td>
            <td style="padding: 13px 20px; font-size: 14px; color: #111827; font-weight: 600; text-align: right; border-top: 1px solid #e5e7eb;">{{ data.companyName }}</td>
        </tr>
        {% endif %}
    </table>

    <p style="margin: 18px 0 0 0; font-size: 13px; color: #6b7280; line-height: 1.6;">{{ 'notifications.partner_status_changed.hint'|trans({}, 'emails', locale) }}</p>
{% endblock %}

{% block cta %}
    {% if data.companyId is defined and data.partnerId is defined %}
    <tr>
        <td style="padding: 0 36px 32px 36px;" align="center">
            <a href="{{ frontendUrl }}/{{ isClient ? 'clients' : 'suppliers' }}/{{ data.partnerId }}?company={{ data.companyId }}" target="_blank"
               style="display: inline-block; background: linear-gradient(135deg, #d97706 0%, #f59e0b 100%); color: #ffffff; font-size: 15px; font-weight: 600; text-decoration: none; padding: 14px 40px; border-radius: 8px; box-shadow: 0 2px 8px rgba(217,119,6,0.3);">
                {{ (isClient ? 'notifications.partner_status_changed.cta_client' : 'notifications.partner_status_changed.cta_supplier')|trans({}, 'emails', locale) }}
            </a>
        </td>
    </tr>
    {% endif %}
{% endblock %}
