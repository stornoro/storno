{% extends 'emails/notification_base.html.twig' %}

{% block accent_gradient %}background: linear-gradient(90deg, #dc2626 0%, #f87171 50%, #fca5a5 100%);{% endblock %}

{% block icon_emoji %}
    <div style="display: inline-block; width: 64px; height: 64px; border-radius: 50%; background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%); text-align: center; line-height: 64px; font-size: 30px; box-shadow: 0 4px 12px rgba(220,38,38,0.15);">
        &#128203;
    </div>
{% endblock %}

{% block heading %}{{ 'notifications.spv_document_received.heading'|trans({}, 'emails', locale) }}{% endblock %}

{% block content %}
    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background-color: #fef2f2; border: 1px solid #fecaca; border-radius: 10px; margin-bottom: 20px;">
        <tr>
            <td style="padding: 18px 20px;">
                <p style="margin: 0 0 6px 0; font-size: 13px; color: #991b1b; text-transform: uppercase; letter-spacing: 0.04em;">{{ data.messageType|default('') }}</p>
                <p style="margin: 0; font-size: 14px; color: #7f1d1d; line-height: 1.5;">{{ message }}</p>
            </td>
        </tr>
    </table>

    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="border: 1px solid #e5e7eb; border-radius: 10px; overflow: hidden;">
        {% if data.companyName is defined %}
        <tr style="background-color: #f9fafb;">
            <td style="padding: 13px 20px; font-size: 14px; color: #6b7280;">CUI / firma</td>
            <td style="padding: 13px 20px; font-size: 14px; color: #111827; font-weight: 600; text-align: right;">{{ data.companyName }}</td>
        </tr>
        {% endif %}
        {% if data.anafCreatedAt is defined and data.anafCreatedAt %}
        <tr>
            <td style="padding: 13px 20px; font-size: 14px; color: #6b7280;">ANAF</td>
            <td style="padding: 13px 20px; font-size: 14px; color: #111827; text-align: right;">{{ data.anafCreatedAt }}</td>
        </tr>
        {% endif %}
    </table>
{% endblock %}
