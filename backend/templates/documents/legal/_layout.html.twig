<!doctype html>
<html lang="ro">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<style>
  @page { size: A4; margin: 22mm 22mm 20mm 22mm; }
  body { font-family: "Times New Roman", Times, "DejaVu Serif", serif; font-size: 12pt; line-height: 1.55; color: #000; }
  h1 { text-align: center; font-size: 15pt; letter-spacing: .4px; margin: 0 0 18px; }
  h2 { font-size: 12pt; margin: 16px 0 6px; }
  p { text-align: justify; margin: 0 0 10px; }
  .parties p { margin-bottom: 8px; }
  .sig { margin-top: 34px; width: 100%; }
  .sig td { width: 50%; vertical-align: top; padding-top: 12px; }
  .muted { color: #444; font-size: 10.5pt; }
</style>
</head>
<body>
<h1>{{ title }}</h1>
{% block body %}{% endblock %}
</body>
</html>
